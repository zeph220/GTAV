{
  "name": "nova-city",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:all": "concurrently -k -n web,api -c blue,green \"npm:dev\" \"npm:dev:server\"",
    "typecheck": "tsc --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run typecheck && npm run build:server && vite build",
    "start:server": "node dist-server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,html,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css,html,yml,yaml}\""
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "better-sqlite3": "13.2.0",
    "fastify": "5.12.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "9.2.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
